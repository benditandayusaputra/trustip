{
	"name": "trustip-app",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc --noEmit -p src/service-worker",
		"lint": "prettier --check . && eslint . --max-warnings 0 && knip && node scripts/check-design-tokens.js",
		"format": "prettier --write .",
		"test": "vitest --run",
		"test:e2e": "playwright test",
		"gen:types": "openapi-typescript ../api/openapi/openapi.yaml -o src/lib/api/schema.d.ts"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@lucide/svelte": "^1.52.0",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-vercel": "^7.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/leaflet": "^1.9.22",
		"@types/node": "^24",
		"@vitest/browser-playwright": "^4.1.12",
		"axe-core": "^4.14.0",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"knip": "^6.40.0",
		"leaflet": "^1.9.4",
		"lighthouse": "^13.5.0",
		"openapi-typescript": "^7.13.0",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"svelte-eslint-parser": "^1.8.1",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"uqr": "^0.1.3",
		"vite": "^8.3.0",
		"vitest": "^4.1.12",
		"vitest-browser-svelte": "^3.1.0"
	},
	"engines": {
		"node": ">=24"
	},
	"overrides": {
		"openapi-typescript": {
			"typescript": "$typescript"
		},
		"minimatch": "^11.0.3",
		"glob": "^14.0.3"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
